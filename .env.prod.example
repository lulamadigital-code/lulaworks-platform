# LulaWorks — PRODUCTION environment template.
# Copy to `.env.prod` (gitignored) on the server and fill in REAL secrets.
# In Phase 2 (AWS) these same keys are injected from Secrets Manager / SSM.
#
#   cp .env.prod.example .env.prod    &&    nano .env.prod
#
# Generate a strong SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string
DEBUG=False
# Your real domain(s) + the droplet IP. Comma-separated, no scheme.
ALLOWED_HOSTS=app.lulaworks.co.za,127.0.0.1,localhost
# Scheme-qualified origins allowed to POST (manager web / admin over HTTPS).
CSRF_TRUSTED_ORIGINS=https://app.lulaworks.co.za

# HTTPS enforcement. Keep False for the FIRST bring-up (HTTP only, before you
# issue a TLS cert), then set True and enable the nginx ssl.conf. See
# docs/DEPLOYMENT.md → "Enabling HTTPS".
SECURE_SSL_REDIRECT=False

# ── PostgreSQL (the `db` container; host stays `db` on the compose network) ───
DB_NAME=lulaworks_platform
DB_USER=lulaworks
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ── Redis (the `redis` container) ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=4

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json          # json in prod (ships cleanly to CloudWatch/Loki); plain in dev

# ── CORS (the origins your Flutter app / web front-end call from) ─────────────
CORS_ALLOWED_ORIGINS=https://app.lulaworks.co.za

# ── Gunicorn tuning (optional overrides; sensible defaults if unset) ──────────
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
# GUNICORN_MAX_REQUESTS=1000

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ── AI provider (optional). Unset = deterministic-first path (free, no LLM). ──
# Keys belong ONLY in this gitignored file (or a secrets manager) — never in git.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Optional monitoring/debug profiles ────────────────────────────────────────
# PGADMIN_EMAIL=admin@lulaworks.co.za
# PGADMIN_PASSWORD=CHANGE_ME
