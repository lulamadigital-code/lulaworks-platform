#: apps/marketing/views.py:44 apps/marketing/views.py:88
msgid "Quotation Management"
msgstr "Gestion des devis"

#: apps/marketing/views.py:44
msgid "Build accurate quotes fast and turn them into jobs in one click."
msgstr ""
"Créez des devis précis rapidement et transformez-les en tâches en un clic."

#: apps/marketing/views.py:45
msgid "Job Management"
msgstr "Gestion des tâches"

#: apps/marketing/views.py:45
msgid "Every job in one view — scope, team, progress, money and paperwork."
msgstr ""
"Chaque tâche dans une seule vue — périmètre, équipe, avancement, argent et "
"paperasse."

#: apps/marketing/views.py:46
msgid "Task Management"
msgstr "Gestion des sous-tâches"

#: apps/marketing/views.py:46
msgid "Break jobs into tasks with checklists, owners and live progress."
msgstr ""
"Décomposez les tâches en sous-tâches avec listes de contrôle, responsables "
"et avancement en direct."

#: apps/marketing/views.py:47
msgid "Raise requests, compare supplier prices and issue purchase orders."
msgstr ""
"Créez des demandes, comparez les prix des fournisseurs et émettez des bons "
"de commande."

#: apps/marketing/views.py:48
msgid "Supplier Intelligence"
msgstr "Intelligence fournisseurs"

#: apps/marketing/views.py:48
msgid "Every receipt teaches the system who sells what, and for how much."
msgstr "Chaque reçu apprend au système qui vend quoi, et à quel prix."

#: apps/marketing/views.py:49
msgid "Document Management"
msgstr "Gestion documentaire"

#: apps/marketing/views.py:49
msgid "POs, invoices, delivery notes and safety files, all in one place."
msgstr ""
"Bons de commande, factures, bons de livraison et dossiers de sécurité, au "
"même endroit."

#: apps/marketing/views.py:50
msgid "AI Document Extraction"
msgstr "Extraction de documents par IA"

#: apps/marketing/views.py:50
msgid "Drop in an RFQ, PO or invoice — AI reads it and fills the details."
msgstr ""
"Déposez une demande de devis, un bon de commande ou une facture — l'IA la "
"lit et remplit les détails."

#: apps/marketing/views.py:51 apps/marketing/views.py:115
msgid "Delivery Notes"
msgstr "Bons de livraison"

#: apps/marketing/views.py:51
msgid "Generate branded delivery notes straight from the job."
msgstr ""
"Générez des bons de livraison à votre image directement depuis la tâche."

#: apps/marketing/views.py:52
msgid "Tax Invoices"
msgstr "Factures fiscales"

#: apps/marketing/views.py:52
msgid "Compliant tax invoices and progress claims, with payments tracked."
msgstr ""
"Factures fiscales conformes et situations d'avancement, avec suivi des "
"paiements."

#: apps/marketing/views.py:53
msgid "GPS & Time Tracking"
msgstr "GPS et suivi du temps"

#: apps/marketing/views.py:53
msgid "Field check-ins are GPS-stamped so you know who was where, when."
msgstr ""
"Les pointages sur le terrain sont horodatés par GPS pour savoir qui était "
"où, et quand."

#: apps/marketing/views.py:54
msgid "Employee Management"
msgstr "Gestion des employés"

#: apps/marketing/views.py:54
msgid "Unlimited employees — technicians, drivers, operators — on every plan."
msgstr ""
"Employés illimités — techniciens, chauffeurs, opérateurs — sur tous les "
"forfaits."

#: apps/marketing/views.py:55
msgid "Reporting & Analytics"
msgstr "Rapports et analyses"

#: apps/marketing/views.py:55
msgid "See profitability, cash flow and job health as the work happens."
msgstr ""
"Visualisez la rentabilité, la trésorerie et la santé des tâches en temps "
"réel."

#: apps/marketing/views.py:59
msgid ""
"We quote in minutes now, and I can finally see which jobs actually make "
"money."
msgstr ""
"Nous établissons des devis en quelques minutes maintenant, et je vois enfin "
"quelles tâches rapportent réellement."

#: apps/marketing/views.py:60
msgid "Managing Director, mechanical contractor"
msgstr "Directeur général, entreprise de mécanique"

#: apps/marketing/views.py:61
msgid ""
"The mobile check-ins ended the arguments about who was on site. It just "
"works."
msgstr ""
