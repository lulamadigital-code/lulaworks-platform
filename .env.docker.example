# Copy to `.env.docker` (gitignored) for local `docker compose`.
# Service hostnames point at the compose services (db, redis), not localhost.
# In production these values come from AWS Secrets Manager, never a file.

SECRET_KEY=change-me-generate-a-real-one
DEBUG=True

DB_NAME=lulaworks_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
